[[edit: audioinfo.go — add "sort" import]]

[[edit: audioinfo.go — replace parseQuery (strings.Fields-based) with
  char-by-char scanner supporting:
    field:"quoted phrase"   — field-scoped multi-word phrase
    "bare phrase"           — unscoped multi-word phrase
    field:/regex/           — field-scoped regex (unchanged)
    /regex/                 — unscoped regex (unchanged)
    field:word              — field-scoped plain term (unchanged)
    word                    — unscoped plain term (unchanged)
  Unclosed " or / falls back to plain-term treatment including the
  opening delimiter. All existing parseQuery tests continue to pass.]]

[[edit: audioinfo.go — GetArtists: add sort.Strings(result) before return]]

